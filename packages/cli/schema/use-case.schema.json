{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^UC-[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "product": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "required": [
        "name",
        "roles"
      ],
      "additionalProperties": false
    },
    "preconditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "postconditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RN-[A-Z][A-Z0-9]*-[0-9]{3}$"
      }
    },
    "endpoints": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^\\/[A-Za-z0-9/:_-]*$"
          }
        },
        "required": [
          "method",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "product",
    "title",
    "actor",
    "preconditions",
    "postconditions",
    "rules",
    "endpoints"
  ],
  "additionalProperties": false
}
